{
  "name": "resume-cv-builder",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "concurrently -n WEB,API -c blue,green \"pnpm --prefix web run dev\" \"pnpm --prefix api run dev\""
  },
  "workspaces": [
    "api",
    "web"
  ],
  "devDependencies": {
    "only-allow": "^1.2.1",
    "@biomejs/biome": "2.3.3",
    "concurrently": "^9.2.1"
  }
}
